# Copy this file to .env.local for local development.
# Configure the same values in your Vercel project for production.

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Database
DATABASE_URL=

# Application
NEXT_PUBLIC_APP_URL=
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_LOGGING_LEVEL=

# Stripe
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SEO analysis backend
SEO_BACKEND_URL=
SEO_BACKEND_API_KEY=

# Optional monitoring and deployment integrations
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORGANIZATION=
SENTRY_PROJECT=
CHECKLY_EMAIL_ADDRESS=
CHECKLY_PROJECT_NAME=
CHECKLY_LOGICAL_ID=
NEXT_PUBLIC_BETTER_STACK_SOURCE_TOKEN=
NEXT_PUBLIC_BETTER_STACK_INGESTING_HOST=
